{
    "extends": "stylelint-config-standard",
    "ignoreFiles": [
        "node_modules/**/*"
    ],
    "overrides": [
        {
            "files": [
                "**/*.css"
            ],
            "rules": {
                "at-rule-no-unknown": [
                    true,
                    {
                        "ignoreAtRules": [
                            "tailwind",
                            "layer",
                            "apply",
                            "responsive",
                            "screen"
                        ]
                    }
                ]
            }
        }
    ]
}